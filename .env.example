# Copy to `.env` on the server (cp .env.example .env) and fill in every value.
# `.env` holds secrets: it is git-ignored and must never be committed.
# Avoid the characters $ ; ' " and spaces in values.

# The port the university gave the project, and the address people open in the browser.
APP_PORT=4047
PUBLIC_URL=http://SERVER_IP:4047

# SQL Server `sa` password: 8+ characters with upper case, lower case and digits.
# Generate one with:  echo "Dt$(openssl rand -hex 16)"
DB_PASSWORD=

# At least 32 characters. Generate one with:  openssl rand -hex 32
# Changing it later signs everyone out.
JWT_SECRET=

# The first administrator, created on the first start only (ignored once an admin exists).
# The password needs 12-128 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
